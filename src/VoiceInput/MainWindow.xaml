<Window x:Class="VoiceInput.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceInput V0.1" Width="680" Height="530" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterScreen" FontSize="14">
    <DockPanel Margin="20" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock FontSize="23" FontWeight="SemiBold" Text="VoiceInput V0.1"/>
            <TextBlock Margin="0,6,0,12" TextWrapping="Wrap"
                       Text="在目标窗口按 Ctrl+Shift+F9 开始录音，再按一次结束。"/>
            <Label Target="{Binding ElementName=EnginePath}" Content="whisper-cli.exe"/>
            <DockPanel Margin="0,0,0,5">
                <Button DockPanel.Dock="Right" Padding="12,3" Click="BrowseEngine">浏览</Button>
                <TextBox x:Name="EnginePath" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
            </DockPanel>
            <Label Target="{Binding ElementName=ModelPath}" Content="多语种模型 (.bin)"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Padding="12,3" Click="BrowseModel">浏览</Button>
                <TextBox x:Name="ModelPath" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
            </DockPanel>
            <WrapPanel Margin="0,12">
                <Label Target="{Binding ElementName=LanguagePicker}" Content="语言"/>
                <ComboBox x:Name="LanguagePicker" Width="155" SelectedIndex="0" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="自动 / 中英混合" Tag="auto"/>
                    <ComboBoxItem Content="中文" Tag="zh"/>
                    <ComboBoxItem Content="英文" Tag="en"/>
                </ComboBox>
                <CheckBox x:Name="UseGpu" Margin="14,0,0,0" VerticalAlignment="Center" Content="启用 NVIDIA CUDA"/>
            </WrapPanel>
            <WrapPanel>
                <Button x:Name="RecordButton" Padding="12,5" Click="ToggleFromButton">开始录音</Button>
                <Button x:Name="CopyButton" Margin="8,0" Padding="12,5" IsEnabled="False" Click="CopyResult">复制结果</Button>
                <Button x:Name="LogButton" Padding="12,5" IsEnabled="False" Click="ShowLog">识别日志</Button>
            </WrapPanel>
            <TextBlock x:Name="Status" Margin="0,10,0,8" Text="就绪" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>
            <Label Target="{Binding ElementName=Result}" Content="识别结果"/>
        </StackPanel>
        <TextBox x:Name="Result" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
